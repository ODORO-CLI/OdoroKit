node_modules/
dist/
coverage/

# Les sorties de compilation, ancrees a la racine.
#
# `build/` sans barre oblique initiale correspond a **n'importe quel** dossier
# de ce nom, a n'importe quelle profondeur. Il a ainsi exclu
# `packages/odoro/src/build/`, qui est du code source : les commandes `build`
# et `preview` de la CLI n'ont jamais ete versionnees, et la compilation
# echouait sur tout depot fraichement clone.
#
# Localement, les fichiers etaient la : personne ne pouvait le voir.
/build/
.turbo/
*.tsbuildinfo
.DS_Store
Thumbs.db
.env
.env.*
!.env.example
*.log
npm-debug.log*
pnpm-debug.log*
.vscode/*
!.vscode/extensions.json
.idea/
test-results/
playwright-report/
.playwright/
*.tgz

# Jamais dans le depot : une cle maitresse poussee est une cle a faire
# tourner, pas a retirer d un historique.
kms-master-key
*.key
*.pem

# Les artefacts de build des templates.
#
# `templates/` porte des projets complets, chacun avec sa propre chaine. Leurs
# dependances et leurs sorties se reconstruisent ; les versionner ajouterait
# plusieurs centaines de megaoctets a un depot qui vient de diviser par deux le
# poids de ce qu'il publie.
templates/*/node_modules/
templates/*/.next/
templates/*/dist/
templates/*/.turbo/
