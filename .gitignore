node_modules/
dist/
coverage/

# Les sorties de compilation, ancrees a la racine.
#
# `build/` sans barre oblique initiale correspond a **n'importe quel** dossier
# de ce nom, a n'importe quelle profondeur. Il a ainsi exclu
# `packages/odoro/src/build/`, qui est du code source : les commandes `build`
# et `preview` de la CLI n'ont jamais ete versionnees, et la compilation
# echouait sur tout depot fraichement clone.
#
# Localement, les fichiers etaient la : personne ne pouvait le voir.
/build/
.turbo/
*.tsbuildinfo
.DS_Store
Thumbs.db
.env
.env.*
!.env.example
*.log
npm-debug.log*
pnpm-debug.log*
.vscode/*
!.vscode/extensions.json
.idea/
test-results/
playwright-report/
.playwright/
*.tgz

# Jamais dans le depot : une cle maitresse poussee est une cle a faire
# tourner, pas a retirer d un historique.
kms-master-key
*.key
*.pem

# Les artefacts de build des templates.
#
# `templates/` porte des projets complets, chacun avec sa propre chaine. Leurs
# dependances et leurs sorties se reconstruisent ; les versionner ajouterait
# plusieurs centaines de megaoctets a un depot qui vient de diviser par deux le
# poids de ce qu'il publie.
templates/*/node_modules/
templates/*/.next/
templates/*/dist/
templates/*/.turbo/

# Le pack de design, republie pour etre servi.
#
# `playground/public/instructive/` est une copie de `ODORO-Design-Pack/`
# produite par `playground/scripts/instructive.mjs`. Versionner les deux
# ferait entrer trois megaoctets en double dans le depot, et ouvrirait la
# porte a ce qu ils divergent sans que rien ne le signale.
playground/public/instructive/

# Les versions des paquets, relevees dans leurs `package.json` par
# `playground/scripts/versions.mjs` avant chaque `dev` et chaque `build`.
# Les versionner ferait exister deux verites pour un meme numero.
playground/src/docs/versions.generated.ts

# Les versions des paquets de la famille, relevees par
# `packages/odoro/scripts/family-versions.mjs` avant chaque compilation.
# Les versionner ferait exister deux verites pour un meme numero.
packages/odoro/src/scaffold/family-versions.generated.ts

# Les exports des vitrines, produits par `scripts/build-vitrine-exports.mjs`
# avant chaque `dev` et chaque `build` du playground.
#
# Soixante megaoctets d archives et de code recopie, deduits de la source a
# chaque generation. Les versionner ferait entrer dans le depot une seconde
# copie de tout ce qu il contient deja, libre de diverger de la premiere.
playground/public/exports/
playground/src/docs/exports.generated.ts

# Les projets livres, prets a etre montres, produits par
# `scripts/build-project-previews.mjs` avant chaque `dev` et chaque `build`.
#
# Cent soixante-dix megaoctets : la construction de chaque gabarit, recopiee
# avec ses adresses rendues relatives pour tenir sous `/projets/<nom>/`. Tout
# s en deduit de `templates/*/dist`, qui se deduit lui-meme de la source.
playground/public/projets/
