{
  "name": "odoro-monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "author": "BouBouw",
  "description": "Monorepo Odoro : scaffolder CLI et librairie front maison.",
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/*\" run build",
    "changeset": "changeset",
    "check:catalogue": "node scripts/check-catalogue.mjs http://localhost:5190",
    "check:classes": "node scripts/check-classes.mjs http://localhost:5190",
    "check:fonds": "node scripts/check-fonds.mjs http://localhost:5190",
    "check:galerie": "node scripts/check-galerie.mjs http://localhost:5190",
    "check:hmr": "node scripts/hmr-check.mjs",
    "check:icones": "node scripts/check-icones.mjs http://localhost:5190",
    "check:interaction": "node scripts/check-interaction.mjs http://localhost:5190",
    "check:moteur": "node scripts/check-moteur.mjs http://localhost:5190",
    "check:smoke": "node scripts/smoke.mjs",
    "dev": "pnpm -r --parallel --filter \"./packages/*\" run dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "playground": "pnpm --filter odoro-playground dev",
    "release": "pnpm build && changeset publish",
    "test": "pnpm -r run test",
    "try:create": "node scripts/try-create.mjs",
    "typecheck": "pnpm -r run typecheck",
    "version-packages": "changeset version"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.7",
    "@eslint/js": "^9.39.1",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^16.5.0",
    "playwright": "^1.62.1",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4",
    "vitest": "^3.2.4"
  }
}
