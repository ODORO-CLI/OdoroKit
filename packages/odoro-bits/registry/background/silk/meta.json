{
  "name": "silk",
  "category": "background",
  "title": "Soie",
  "description": "Un ecoulement obtenu en deplacant le domaine deux fois de suite.",
  "engine": {
    "gsap": [],
    "gl": "ogl"
  },
  "files": [
    {
      "path": "component.tsx",
      "target": "background/Silk.tsx"
    }
  ],
  "dependencies": [],
  "registryDependencies": [],
