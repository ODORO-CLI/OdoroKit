{
  "name": "rain",
  "category": "background",
  "title": "Pluie",
  "description": "Des trainees verticales, une vitesse par colonne.",
  "engine": {
    "gsap": [],
    "gl": "ogl"
  },
  "files": [
    {
      "path": "component.tsx",
      "target": "background/Rain.tsx"
    }
