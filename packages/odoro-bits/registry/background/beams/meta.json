{
  "name": "beams",
  "category": "background",
  "title": "Faisceaux",
  "description": "Des rais de lumiere obliques, deplaces par un bruit.",
  "engine": {
    "gsap": [],
    "gl": "ogl"
  },
  "files": [
    {
      "path": "component.tsx",
      "target": "background/Beams.tsx"
    }
  ],
  "dependencies": [],
  "registryDependencies": [],
  "tokens": ["--o-palette-zinc-950", "--o-palette-brand-500", "--o-palette-fuchsia-500"],
  "props": [
    {
      "name": "speed",
      "type": "number",
