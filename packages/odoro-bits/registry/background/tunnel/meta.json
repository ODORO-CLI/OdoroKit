    {
      "name": "colors",
      "type": "readonly string[]",
      "description": "Tokens dont les couleurs sont lues."
    },
    {
      "name": "fallback",
      "type": "string",
      "description": "Classes du repli, affiche pendant le chargement et si WebGL manque."
    }
  ],
  "perf": {
    "tier": "light",
    "backend": "ogl",
