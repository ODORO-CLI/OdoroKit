{
  "name": "tunnel",
  "category": "background",
  "title": "Tunnel",
  "description": "Une perspective obtenue en posant z = 1/r, sans camera ni matrice.",
  "engine": {
    "gsap": [],
    "gl": "ogl"
  },
  "files": [
    {
      "path": "component.tsx",
      "target": "background/Tunnel.tsx"
    }
  ],
  "dependencies": [],
  "registryDependencies": [],
