    {
      "name": "intensity",
      "type": "number",
      "default": 1,
      "description": "Force de la lumiere.",
      "min": 0,
      "max": 2,
      "step": 0.05
    },
    {
      "name": "colors",
      "type": "readonly string[]",
      "description": "Tokens dont les couleurs sont lues."
    },
    {
      "name": "fallback",
      "type": "string",
      "description": "Classes du repli, affiche pendant le chargement et si WebGL manque."
    }
  ],
  "perf": {
    "tier": "medium",
    "backend": "ogl",
    "fallback": "gradient",
