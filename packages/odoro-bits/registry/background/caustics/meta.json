{
  "name": "caustics",
  "category": "background",
  "title": "Caustiques",
  "description": "Le reseau de lumiere au fond d un bassin, imite par replis successifs.",
  "engine": {
    "gsap": [],
    "gl": "ogl"
  },
  "files": [
    {
      "path": "component.tsx",
      "target": "background/Caustics.tsx"
    }
  ],
  "dependencies": [],
  "registryDependencies": [],
  "tokens": [
    "--o-palette-sky-950",
    "--o-palette-sky-200"
  ],
  "props": [
    {
      "name": "speed",
      "type": "number",
      "default": 0.5,
