{
  "name": "odoro",
  "version": "0.1.2",
  "type": "module",
  "license": "UNLICENSED",
  "author": "BouBouw",
  "description": "Moteur de developpement et echafaudage Odoro : odoro create, dev, build, preview.",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "odoro": "./dist/cli.js"
  },
  "files": [
    "dist",
    "templates",
    "client.d.ts"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./client": {
      "types": "./client.d.ts"
    },
    "./cli": {
      "types": "./dist/cli.d.ts",
      "import": "./dist/cli.js"
    },
    "./registry": {
      "types": "./dist/registry/index.d.ts",
      "import": "./dist/registry/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@babel/core": "^8.0.1",
    "@clack/prompts": "^0.11.0",
    "esbuild": "^0.28.2",
    "picocolors": "^1.1.1",
    "react-refresh": "^0.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.18.8",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "zod": "^4.5.1"
  }
}
