# Copy this file to `.env` and adjust the values.
#
# Any missing or invalid variable stops the server at startup, with a message
# listing them all at once: an immediate failure beats an outage on the
# hundredth request.
#
# This file is committed. `.env` never is.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------

# PostgreSQL, and nothing else. No local database: the URL points at a hosted
# one, yours or the one provisioned by `odoro db:create`.
#
#   postgres://user:password@host:5432/database?sslmode=require
#
# While it is missing, the client starts and the server answers 503 on
# /api/ready saying what is absent.
DATABASE_URL=

# Read replica, optional. Routing to it stays explicit: never an automatic
# switch, replication lag produces bugs nobody can make sense of.
# DATABASE_REPLICA_URL=

# Connection pool size. Leave empty for the environment default.
# DATABASE_POOL_MAX=

# Disables TLS. Only ever set this for a database strictly local to the
# machine, never for one reachable over the network.
# DATABASE_TLS_DISABLED=false

# ---------------------------------------------------------------------------
# Session
# ---------------------------------------------------------------------------

# At least 32 characters. A short secret falls to brute force, and the day that
# happens, every session issued since day one can be forged.
#
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------

# Environment: development | test | production
NODE_ENV=development

# Listening port of the API. The development client listens on 5180 and
# forwards the calls starting with /api to it.
PORT=3001

# Public URL of the server, used in the links of outgoing emails.
APP_URL=http://localhost:3001

# Allowed origins, comma separated. Empty = no third-party origin. Never `*`
# together with credentials.
ALLOWED_ORIGINS=

# Cap on the size of request bodies.
BODY_LIMIT=1mb

# Delay after which the graceful shutdown stops waiting for in-flight requests.
SHUTDOWN_TIMEOUT=15s

# Log level: fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Queues and cache
# ---------------------------------------------------------------------------

# Optional. Absent, the cache lives in memory and the jobs run inline — which
# suits a single instance, and nothing beyond.
# REDIS_URL=
