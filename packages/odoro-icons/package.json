{
  "name": "@odoro-cli/icons",
  "version": "2.0.0",
  "type": "module",
  "license": "UNLICENSED",
  "author": "BouBouw",
  "description": "Odoro icon module: several packs normalised on one contract, one export per icon so that tree shaking works.",
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./outline": {
      "types": "./dist/outline.d.ts",
      "import": "./dist/outline.js"
    },
    "./compact": {
      "types": "./dist/compact.d.ts",
      "import": "./dist/compact.js"
    },
    "./classic": {
      "types": "./dist/classic.d.ts",
      "import": "./dist/classic.js"
    },
    "./extended": {
      "types": "./dist/extended.d.ts",
      "import": "./dist/extended.js"
    },
    "./brands": {
      "types": "./dist/brands.d.ts",
      "import": "./dist/brands.js"
    },
    "./catalogue.json": "./dist/catalogue.json",
    "./package.json": "./package.json"
  },
  "scripts": {
    "icons:import": "tsx scripts/import-icons.ts",
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@fortawesome/fontawesome-free": "^7.3.1",
    "@material-symbols/svg-400": "^0.47.0",
    "@types/react": "^19.2.2",
    "bootstrap-icons": "^1.13.1",
    "lucide-static": "^1.37.0",
    "react": "^19.2.0",
    "tsup": "^8.5.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
