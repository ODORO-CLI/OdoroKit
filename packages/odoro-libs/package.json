{
  "name": "@odoro-cli/libs",
  "version": "0.1.2",
  "type": "module",
  "license": "UNLICENSED",
  "author": "BouBouw",
  "description": "Librairie front maison Odoro : router, moteur d'animation, systeme de style et composants UI.",
  "engines": {
    "node": ">=20"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./router": {
      "types": "./dist/router.d.ts",
      "import": "./dist/router.js"
    },
    "./motion": {
      "types": "./dist/motion.d.ts",
      "import": "./dist/motion.js"
    },
    "./motion-policy": {
      "types": "./dist/motion-policy.d.ts",
      "import": "./dist/motion-policy.js"
    },
    "./tokens": {
      "types": "./dist/tokens.d.ts",
      "import": "./dist/tokens.js"
    },
    "./ui": {
      "types": "./dist/ui.d.ts",
      "import": "./dist/ui.js"
    },
    "./styles": {
      "types": "./dist/styles.d.ts",
      "import": "./dist/styles.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json",
    "./styles.full.css": "./dist/styles.full.css"
  },
  "scripts": {
    "build:css": "tsx scripts/build-css.ts",
    "build": "pnpm run build:css && tsup",
    "dev": "pnpm run build:css && tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check:exports": "publint && attw --pack . --profile esm-only --exclude-entrypoints styles.css styles.full.css",
    "prepublishOnly": "pnpm run build"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.1",
    "jsdom": "^27.0.0",
    "publint": "^0.3.16",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tsup": "^8.5.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
